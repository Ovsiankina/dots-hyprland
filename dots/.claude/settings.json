{
  "permissions": {
    "allow": [
      "Bash(sqlite3:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(grep:*)",
      "Bash(systemctl --user list-timers*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-context.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-context.py\" question",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-context.py\" permission",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-context.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-context.py\" end",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-statusbar.py\"",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "vibe-annotations@local": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "agentPushNotifEnabled": true,
  "_comment": [
    "This file is STOWED: ~/.claude/settings.json is a symlink into",
    "~/dotfiles/dots/.claude/settings.json. Claude Code edits this file itself",
    "(e.g. when you approve a permission with 'always'). If it writes via",
    "temp-file + rename rather than in place, that rename REPLACES the symlink",
    "with a real file and the repo copy silently goes stale.",
    "CHECK: ls -la ~/.claude/settings.json -- if it no longer shows '->', this",
    "file needs a copy step in main.sh instead of a stow link.",
    "Paths use ${CLAUDE_CONFIG_DIR:-$HOME/.claude} and MUST stay double-quoted;",
    "single quotes block shell expansion and every hook dies silently.",
    "JSON has no comments -- // breaks the parser and Claude Code drops the whole",
    "file (measured 2026-09-08), which is why this note is a key."
  ]
}
