/diagnose.result
/cache

# Ignore Python cache files
__pycache__/
*.py[cod]

/dots/.config/quickshell/ii/.qmlls.ini

# exp-update
/.update-lock

# custom os-release
/os-release

# Emacs auto backup file
*~

# ZSH history
dots/.zsh/.zsh_history

# Stow-managed symlinks (created by running stow from dots/)
.zsh

# Machine-specific files (colors from matugen, monitor layout)
# Defaults live in .installation/defaults/ and are copied on fresh install
dots/.config/fuzzel/fuzzel_theme.ini
dots/.config/kdeglobals
dots/.config/hypr/hyprland/colors.conf
dots/.config/hypr/hyprland/monitors.conf
dots/.config/hypr/hyprlock/colors.conf
dots/.config/hypr/monitors.conf
dots/.config/hypr/monitors.lua

# Claude Code session/project dirs (can appear under any cwd).
# Unanchored, so it matches at every depth -- including the packaged config we
# DO track, hence the negation. Order matters: the re-include must come second,
# and must name the directory itself (git never descends into an excluded dir).
.claude/
!/dots/.claude/

# makepkg build artifacts under arch-packages (source clones, src/pkg dirs, built packages)
.installation/arch-packages/**/src/
.installation/arch-packages/**/pkg/
.installation/arch-packages/**/*.pkg.tar.*
.installation/arch-packages/illogical-impulse/ii-quickshell-git/quickshell/
